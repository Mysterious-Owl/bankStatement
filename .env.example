# Copy this file to .env and adjust. .env is git-ignored; this file is not,
# so keep real names and paths out of it.

# Folder holding statements, mappings, rules and annotations.
# Default: the "data" folder inside this repo.
# BANKS_DATA_DIR=/path/to/your/data

# Banks offered in the upload picker and recognised in statement filenames,
# comma-separated. Banks in data/config/bank_names.csv are added automatically.
KNOWN_BANKS=HDFC,SBI,ICICI,AXIS,KOTAK,IDFC,PNB
